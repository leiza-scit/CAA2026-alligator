aeont:ServiceCount
    rdf:type rdfs:Class ;
    rdfs:comment "The number of Arretine sherds of one service type recorded at one findspot. One node per non-empty cell of the workbook."@en ;
    rdfs:label "Service type count"@en .

aeont:atFindspot
    rdf:type rdf:Property ;
    rdfs:comment "The findspot the count was recorded at."@en ;
    rdfs:domain aeont:ServiceCount ;
    rdfs:label "at findspot"@en ;
    rdfs:range fsl:Site .

aeont:columnRank
    rdf:type rdf:Property ;
    rdfs:comment "Rank within the concept's own group, numbering the group's sub-types 1..k in column order, so a cup and a plate of the same stage are one step apart. The 'column' reading of the RGZM rank schemes; kept so the alternative can be re-checked, not because it is preferred. Numbering starts at 1 with no gaps, as for stage rank."@en ;
    rdfs:domain skos:Concept ;
    rdfs:label "column rank"@en ;
    rdfs:range xsd:integer .

aeont:serviceType
    rdf:type rdf:Property ;
    rdfs:comment "The service type counted, as a concept of the Arretine typology."@en ;
    rdfs:domain aeont:ServiceCount ;
    rdfs:label "service type"@en ;
    rdfs:range skos:Concept .

aeont:sherdCount
    rdf:type rdf:Property ;
    rdfs:comment "The count itself. Percentages are deliberately not stored: they follow from these counts, and a second copy of a derived number is a second thing to keep true."@en ;
    rdfs:domain aeont:ServiceCount ;
    rdfs:label "sherd count"@en ;
    rdfs:range xsd:integer .

aeont:stageRank
    rdf:type rdf:Property ;
    rdfs:comment "Rank within the concept's own group, numbering stages rather than sub-types, so a cup and a plate of the same stage share a rank. The reading this project reports: a change of vessel form is not a chronological step, and treating it as one would be an artefact. The two readings agree closely in any case (r = 0.998). NUMBERING CONVENTION, part of the method rather than an implementation detail: the first stage of every group carries rank 1 and ranks run 1..k in stage order with no gaps. The quality score q = exp(-s/x̄) divides by the mean rank and so depends on where the numbering starts; the standard deviation s does not. Any q quoted from this graph is only reproducible together with this convention."@en ;
    rdfs:domain skos:Concept ;
    rdfs:label "stage rank"@en ;
    rdfs:range xsd:integer .

aeont:typologicalRank
    rdf:type rdf:Property ;
    rdfs:comment "Position in the conventional order of the whole typology, as the workbook columns give it, 1 to 9. A display sort key."@en ;
    rdfs:domain skos:Concept ;
    rdfs:label "typological rank"@en ;
    rdfs:range xsd:integer .

aeont:vesselForm
    rdf:type rdf:Property ;
    rdfs:comment "Cup or plate. Orthogonal to the stage axis carried by skos:broader."@en ;
    rdfs:domain skos:Concept ;
    rdfs:label "vessel form"@en ;
    rdfs:range skos:Concept .

ae:site_Trier-Petrisberg
    dct:description "Aucun horizon chronologique : un seul type de service représenté (Schrägrandteller uniquement) : l'analyse des correspondances écarte donc le site, qui n'a ni coordonnée AFC, ni date Alligator, ni horizon."@fr ;
    dct:description "No chronological horizon: one service type represented (Schrägrandteller only), so the correspondence analysis drops the findspot: no CA coordinate, hence no Alligator date and no horizon."@en .

<http://leiza-scit.github.io/CAA2026-alligator/source/ArretineDatedSitesServicesI_II.xlsx>
    rdf:type prov:Entity ;
    rdfs:label "ArretineDatedSitesServicesI_II.xlsx"@en .

