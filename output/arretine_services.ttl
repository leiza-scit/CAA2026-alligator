    skos:prefLabel "Service Ic Teller"@de ;
    skos:prefLabel "Service Ic assiette"@fr ;
    skos:prefLabel "Service Ic plate"@en .

aevoc:Tasse
    rdf:type skos:Concept ;
    skos:inScheme aevoc:services ;
    skos:prefLabel "Cup"@en ;
    skos:prefLabel "Tasse"@de ;
    skos:prefLabel "Tasse"@fr .

aevoc:Teller
    rdf:type skos:Concept ;
    skos:inScheme aevoc:services ;
    skos:prefLabel "Assiette"@fr ;
    skos:prefLabel "Plate"@en ;
    skos:prefLabel "Teller"@de .

aevoc:services
    rdf:type skos:ConceptScheme ;
    rdfs:comment "Two axes: a stage sequence carried by skos:broader, and a vessel form carried by aeont:vesselForm. The three top concepts are the groups the within-group variance is computed over."@en ;
    skos:hasTopConcept aevoc:Schraegrandteller ;
    skos:hasTopConcept aevoc:ServiceI ;
    skos:hasTopConcept aevoc:ServiceII ;
    skos:prefLabel "Arretine service typology"@en ;
    skos:prefLabel "Typologie der arretinischen Services"@de ;
    skos:prefLabel "Typologie des services arétins"@fr .
