ae:event_Clades_Variana a crm:E7_Activity,
        time:Interval ;
    rdfs:label "Clades Variana"@en ;
    time:hasBeginning ae:event_Clades_Variana_begin ;
    time:hasEnd ae:event_Clades_Variana_end .

