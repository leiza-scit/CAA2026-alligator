@prefix dm: <http://leiza-scit.github.io/CAA2026-alligator/dm#> .
@prefix aeont: <http://leiza-scit.github.io/CAA2026-alligator/ontology#> .
@prefix aevoc: <http://leiza-scit.github.io/CAA2026-alligator/vocabulary/> .
@prefix aecol: <http://leiza-scit.github.io/CAA2026-alligator/collections/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix lado: <http://archaeology.link/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:assemblage a dm:Assemblage , crm:E18_Physical_Thing ;
    dm:totalSherds 100 ;
    crm:P12i_was_present_at _:deposition ;
    dm:hasCount _:count_1 , _:count_2 , _:count_3 , _:count_4 , _:count_5 .

_:deposition a crm:E5_Event .

_:count_1 a aeont:ServiceCount ;
    aeont:serviceType aevoc:Schraegrandteller ;
    aeont:sherdCount 0 .

_:count_2 a aeont:ServiceCount ;
    aeont:serviceType aevoc:ServiceIa ;
    aeont:sherdCount 0 .

_:count_3 a aeont:ServiceCount ;
    aeont:serviceType aevoc:ServiceIb ;
    aeont:sherdCount 13 .

_:count_4 a aeont:ServiceCount ;
    aeont:serviceType aevoc:ServiceIc ;
    aeont:sherdCount 27 .

_:count_5 a aeont:ServiceCount ;
    aeont:serviceType aevoc:ServiceII ;
    aeont:sherdCount 60 .

_:assessment a dm:HorizonAssessment , crm:E7_Activity ;
    dm:method "Dirichlet-multinomial predictive likelihood" ;
    dm:pseudocount 0.500000 ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "2026-01-01T00:00:00Z"^^xsd:dateTime ] ;
    crm:P16_used_specific_object <https://leiza-scit.github.io/CAA2026-alligator/dating.html> , <https://github.com/leiza-scit/CAA2026-alligator/blob/main/output/horizon_reference_profiles.csv> ;
    crm:P9_consists_of
        [ a dm:HorizonResult , crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to _:deposition ; crm:P177_assigned_property_of_type crm:P10_falls_within ; crm:P141_assigned aecol:horizon_1 ; dm:prior 0.200000 ; dm:probability 0.000000 ; dm:logLikelihood -169.147056 ] ,
        [ a dm:HorizonResult , crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to _:deposition ; crm:P177_assigned_property_of_type crm:P10_falls_within ; crm:P141_assigned aecol:horizon_2 ; dm:prior 0.200000 ; dm:probability 0.000001 ; dm:logLikelihood -107.839407 ] ,
        [ a dm:HorizonResult , crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to _:deposition ; crm:P177_assigned_property_of_type crm:P10_falls_within ; crm:P141_assigned aecol:horizon_3 ; dm:prior 0.200000 ; dm:probability 0.845502 ; dm:logLikelihood -93.799599 ] ,
        [ a dm:HorizonResult , crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to _:deposition ; crm:P177_assigned_property_of_type crm:P10_falls_within ; crm:P141_assigned aecol:horizon_4 ; dm:prior 0.200000 ; dm:probability 0.154497 ; dm:logLikelihood -95.499354 ] ,
        [ a dm:HorizonResult , crm:E13_Attribute_Assignment ; crm:P140_assigned_attribute_to _:deposition ; crm:P177_assigned_property_of_type crm:P10_falls_within ; crm:P141_assigned aecol:horizon_5 ; dm:prior 0.200000 ; dm:probability 0.000000 ; dm:logLikelihood -132.412317 ] .

<https://github.com/leiza-scit/CAA2026-alligator/blob/main/output/horizon_reference_profiles.csv> a crm:E73_Information_Object ;
    dm:countsSha256 "342fd585f20733c3d56803e0672c8115afe2f4550458b1cfb2b821f6b1e5fe1c" .

<https://leiza-scit.github.io/CAA2026-alligator/dating.html> a crm:E70_Thing .

aecol:horizon_1 a lado:ChronologicalHorizon , crm:E4_Period .

aecol:horizon_2 a lado:ChronologicalHorizon , crm:E4_Period .

aecol:horizon_3 a lado:ChronologicalHorizon , crm:E4_Period .

aecol:horizon_4 a lado:ChronologicalHorizon , crm:E4_Period .

aecol:horizon_5 a lado:ChronologicalHorizon , crm:E4_Period .
